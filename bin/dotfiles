#!/usr/bin/env bash
# ==============================================================================
# Moved: this project now lives in the dotfiles/ folder of github.com/uarslandev/infra.
# This forwarder keeps old commands working:
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/uarslandev/dotfiles/main/bin/dotfiles)"
# New command:
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/uarslandev/infra/main/bin/dotfiles)"
# The infra bootstrap clones infra to ~/Repos/infra and moves an old clone of this repo in ~/.dotfiles
# aside to ~/.dotfiles.old (nothing is deleted).
# ==============================================================================
set -euo pipefail

NEW_URL="https://raw.githubusercontent.com/uarslandev/infra/main/bin/dotfiles"

printf '\033[38;2;249;226;175m\033[1m[!]\033[0m %b\n    %s\n' \
    "dotfiles moved into \033[1mgithub.com/uarslandev/infra\033[0m (dotfiles/). Forwarding there; next time use:" \
    "bash -c \"\$(curl -fsSL ${NEW_URL})\""

script="$(curl -fsSL "$NEW_URL")" || { echo "Could not download ${NEW_URL}" >&2; exit 1; }
exec bash -c "$script" dotfiles "$@"
