set $mod Mod4
set $term foot
set $menu wofi --show drun
set $browser torbrowser-launcher
set $mail thunderbird

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

font pango:monospace 10

output * bg #000000 solid_color

gaps inner 0
gaps outer 0
smart_gaps on
smart_borders on
hide_edge_borders smart

# Color variables
set $color_bg      #000000
set $color_fg      #ffffff
set $color_muted   #777777
set $color_urgent  #ff0000

default_border pixel 1
default_floating_border pixel 1
client.focused          $color_fg     $color_bg $color_fg     $color_fg     $color_fg
client.unfocused        $color_bg     $color_bg $color_muted  $color_bg     $color_bg
client.focused_inactive $color_bg     $color_bg $color_muted  $color_bg     $color_bg
client.urgent           $color_urgent $color_bg $color_urgent $color_urgent $color_urgent

floating_modifier $mod normal
focus_follows_mouse no

# Move spawned window to workspace AND switch to that workspace tab automatically
for_window [app_id="foot"] move container to workspace $ws1, workspace $ws1
for_window [class="(?i)(firefox|tor browser|brave-browser|chromium)"] move container to workspace $ws2, workspace $ws2
for_window [class="(?i)(thunderbird|evolution|mail)"] move container to workspace $ws3, workspace $ws3
for_window [class="(?i)discord"] move container to workspace $ws4, workspace $ws4
for_window [class="(?i)steam"] move container to workspace $ws4, workspace $ws4
for_window [class="(?i)gimp.*"] move container to workspace $ws5, workspace $ws5

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec $browser
bindsym $mod+m exec $mail
bindsym $mod+Shift+g exec gimp
bindsym $mod+Shift+d exec discord
bindsym $mod+Shift+s exec steam
bindsym $mod+Shift+f exec swaylock -f -c 000000
bindsym Print exec grim -g "$(slurp)" - | wl-copy

bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m "Exit Sway?" -b "Yes" "swaymsg exit"

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

bar {
  status_command i3status
  position top
  font pango:DeJaVu Sans Mono 8

  colors {
    background $color_bg
    statusline $color_fg
    separator  $color_muted

    focused_workspace  $color_fg     $color_fg     $color_bg
    active_workspace   $color_bg     $color_bg     $color_fg
    inactive_workspace $color_bg     $color_bg     $color_muted
    urgent_workspace   $color_urgent $color_urgent $color_fg
  }
}
