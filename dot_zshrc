# Path to Oh-My-Zsh installation installed via Arch AUR package
export ZSH="/usr/share/oh-my-zsh"

# Set theme
ZSH_THEME="agnoster"

# Oh-My-Zsh Plugins
plugins=(git sudo history extract)

# Source Oh-My-Zsh core library
source $ZSH/oh-my-zsh.sh

# Ensure ~/.local/bin is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Zsh Autosuggestions (Fish-like auto-completion)
if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#565f89"
fi

# Zsh Syntax Highlighting (Fish-like command coloring)
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# DevOps & CLI Shortcuts
alias k="kubectl"
alias k9="k9s"
alias tf="terraform"
alias p="podman"
alias vi="nvim"
alias vim="nvim"

# Git Shortcuts
alias gs="git status -sb"
alias gl="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gd="git diff"
alias gc="git commit"

# Dotfiles & Ansible Shortcuts
alias dotsync="chezmoi re-add && chezmoi cd && git add . && git commit -m 'update dotfiles' && git push && exit"
alias ansible-apply="ansible-playbook -k '$(hostname).yml' --ask-become-pass"
alias u="pushd ~/ansible; ansible-apply; popd"
alias b="backup-all"
alias backup-all="chezmoi re-add && git -C ~/.local/share/chezmoi add . && git -C ~/.local/share/chezmoi commit -m 'backup: dotfiles' && git -C ~/.local/share/chezmoi push; git -C ~/ansible add . && git -C ~/ansible commit -m 'backup: ansible monorepo' && git -C ~/ansible push"
alias zshrc="nvim ~/.zshrc"
alias n="nvim"
alias vi="nvim"
alias vim="nvim"
alias sd="backup-all & shutdown now"
alias t="tmux"

# Added by Antigravity CLI installer
export PATH="/home/user/.local/bin:$PATH"

# Trigger tmux-sessionizer with Ctrl+F
bindkey -s '^f' "tmux-sessionizer\n"
bindkey -s '^o' "opencode --auto"
bindkey -s '^k' "tmux kill-server\n"

# Make the sessionized folder the base folder in tmux sessions:
# Prevent `cd` or `cd ~` from leaving the opened project/session folder.
export REAL_HOME="$HOME"

cd() {
    local session_base="${TMUX_SESSION_PATH}"
    if [[ -z "$session_base" && -n "$TMUX" ]]; then
        local p
        p=$(tmux show-environment TMUX_SESSION_PATH 2>/dev/null)
        if [[ "$p" =~ ^TMUX_SESSION_PATH= ]]; then
            session_base="${p#TMUX_SESSION_PATH=}"
            export TMUX_SESSION_PATH="$session_base"
        fi
    fi

    if [[ -n "$session_base" ]]; then
        # `cd`, `cd ~`, `cd ~/`, `cd "$HOME"`, or `cd "$HOME/"` returns to the session base folder
        if [[ $# -eq 0 || "$1" == "$HOME" || "$1" == "$HOME/" || "$1" == "~" || "$1" == "~/" ]]; then
            builtin cd -- "$session_base"
            return $?
        fi

        # If a tilde/home-relative subpath exists inside the project base, prioritize it
        if [[ "$1" == "$HOME"/* ]]; then
            local rel="${1#$HOME/}"
            if [[ -d "$session_base/$rel" ]]; then
                builtin cd -- "$session_base/$rel"
                return $?
            fi
        fi
    fi

    builtin cd "$@"
}
