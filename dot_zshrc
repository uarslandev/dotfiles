# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your Oh-My-Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set theme to Powerlevel10k
ZSH_THEME="powerlevel10k/powerlevel10k"

# Oh-My-Zsh Plugins
plugins=(git sudo history extract)

source $ZSH/oh-my-zsh.sh

# Ensure ~/.local/bin is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Zsh Autosuggestions (Fish-like auto-completion)
if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#565f89"
fi

# Zsh Syntax Highlighting (Fish-like command coloring)
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# DevOps & CLI Shortcuts
alias k="kubectl"
alias k9="k9s"
alias tf="terraform"
alias p="podman"
alias vi="nvim"
alias vim="nvim"

# Git Shortcuts
alias gs="git status -sb"
alias gl="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gd="git diff"
alias gc="git commit"

# Dotfiles, GNOME & Ansible Backup Shortcuts
alias gnome-backup="dconf dump / > ~/.config/dconf/settings.dconf && chezmoi re-add ~/.config/dconf/settings.dconf"
alias dotsync="dconf dump / > ~/.config/dconf/settings.dconf && chezmoi re-add && chezmoi cd && git add . && git commit -m 'update dotfiles & gnome settings' && git push && exit"
alias ansible-apply="ansible-playbook ~/ansible/site.yml --ask-become-pass"
alias backup-all="dconf dump / > ~/.config/dconf/settings.dconf && chezmoi re-add && git -C ~/.local/share/chezmoi add . && git -C ~/.local/share/chezmoi commit -m 'backup: dotfiles and gnome settings' && git -C ~/.local/share/chezmoi push; git -C ~/ansible add . && git -C ~/ansible commit -m 'backup: ansible monorepo' && git -C ~/ansible push"
alias zshrc="nvim ~/.zshrc"
alias n="nvim"
alias vi="nvim"
alias vim="nvim"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
